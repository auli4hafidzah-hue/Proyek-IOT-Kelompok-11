    { "type": "wokwi-dht22", "id": "dht1", "top": -40, "left": 150, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 80, "left": 160, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 130, "left": 150, "attrs": { "value": "220" } },
